{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "if [ \"$VERCEL\" = \"1\" ] && grep -q '<main' dist/index.html 2>/dev/null; then echo 'Pre-built SSG dist/ detected, skipping vite build' && cp public/sitemap.xml dist/ 2>/dev/null && cp public/robots.txt dist/ 2>/dev/null && cp public/3fd67103052cd75b3b1146cf0670b20e.txt dist/ 2>/dev/null && cp public/manifest.json dist/ 2>/dev/null && echo 'Pre-built SSG ready'; else vite build && node prerender.mjs; fi",
    "build:ssg": "vite build && node prerender.mjs",
    "prerender": "node prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "2.1.1",
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "lighthouse": "^13.4.0",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  },
  "optionalDependencies": {}
}
