{
  "version": 2,
  "builds": [
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "^/(.*\\..+)$", "dest": "/dist/$1" },
    { "src": "^/tallyprime/implementation(/.*)?$", "dest": "/dist/tallyprime/implementation/index.html" },
    { "src": "^/tallyprime/licensing(/.*)?$", "dest": "/dist/tallyprime/licensing/index.html" },
    { "src": "^/tallyprime/cloud-hosting(/.*)?$", "dest": "/dist/tallyprime/cloud-hosting/index.html" },
    { "src": "^/tallyprime/training(/.*)?$", "dest": "/dist/tallyprime/training/index.html" },
    { "src": "^/tallyprime/support(/.*)?$", "dest": "/dist/tallyprime/support/index.html" },
    { "src": "^/tallyprime/customization(/.*)?$", "dest": "/dist/tallyprime/customization/index.html" },
    { "src": "^/tallyprime/data-migration(/.*)?$", "dest": "/dist/tallyprime/data-migration/index.html" },
    { "src": "^/tallyprime(/.*)?$", "dest": "/dist/tallyprime/index.html" },
    { "src": "^/industries/manufacturing(/.*)?$", "dest": "/dist/industries/manufacturing/index.html" },
    { "src": "^/industries/distribution(/.*)?$", "dest": "/dist/industries/distribution/index.html" },
    { "src": "^/industries/retail(/.*)?$", "dest": "/dist/industries/retail/index.html" },
    { "src": "^/industries/construction(/.*)?$", "dest": "/dist/industries/construction/index.html" },
    { "src": "^/industries/hardware(/.*)?$", "dest": "/dist/industries/hardware/index.html" },
    { "src": "^/industries/ngos(/.*)?$", "dest": "/dist/industries/ngos/index.html" },
    { "src": "^/industries/schools(/.*)?$", "dest": "/dist/industries/schools/index.html" },
    { "src": "^/industries/saccos(/.*)?$", "dest": "/dist/industries/saccos/index.html" },
    { "src": "^/industries(/.*)?$", "dest": "/dist/industries/index.html" },
    { "src": "^/about(/.*)?$", "dest": "/dist/about/index.html" },
    { "src": "^/blog(/.*)?$", "dest": "/dist/blog/index.html" },
    { "src": "^/contact(/.*)?$", "dest": "/dist/contact/index.html" },
    { "src": "^/faq(/.*)?$", "dest": "/dist/faq/index.html" },
    { "src": "^/pricing(/.*)?$", "dest": "/dist/pricing/index.html" },
    { "src": "^/knowledge-hub(/.*)?$", "dest": "/dist/knowledge-hub/index.html" },
    { "src": "^/(.*)$", "dest": "/dist/index.html" }
  ]
}
