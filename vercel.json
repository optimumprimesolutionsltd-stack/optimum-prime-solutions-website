      "dest": "/dist/blog/tallyprime-71-is-here-whats-new-and-what-it-means-for-your-business/index.html"
    },
    {
      "src": "^/blog/etims\\-income\\-tax\\-deadline\\-june\\-30\\-2026(/)?$",
      "status": 301,
      "headers": { "Location": "/blog/" }
    },
    {
      "src": "^/blog/why\\-tallyprime\\-alone\\-isn\\-t\\-enough\\-for\\-growing\\-kenyan\\-businesses(/)?$",
      "status": 301,
      "headers": { "Location": "/blog/" }
    },
    {
      "src": "^/blog/tallyprime\\-7\\-1\\-released\\-how\\-the\\-new\\-features\\-help\\-kenyan\\-businesses\\-navigate\\-etims\\-2026(/)?$",
      "status": 301,
      "headers": { "Location": "/blog/" }
    },
    {
      "src": "^/blog(/)?$",
      "dest": "/dist/blog/index.html"
    },
    {
      "src": "^/(.*)$",
      "status": 404,
      "dest": "/dist/404.html"
    }
  ]
