{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    {
      "src": "^/(.*\\..+)$",
      "dest": "/$1"
    },
    {
      "src": "^/tallyprime/implementation(/.*)?$",
      "dest": "/tallyprime/implementation/index.html"
    },
    {
      "src": "^/tallyprime/licensing(/.*)?$",
      "dest": "/tallyprime/licensing/index.html"
    },
    {
      "src": "^/tallyprime/cloud-hosting(/.*)?$",
      "dest": "/tallyprime/cloud-hosting/index.html"
    },
    {
      "src": "^/tallyprime/training(/.*)?$",
      "dest": "/tallyprime/training/index.html"
    },
    {
      "src": "^/tallyprime/support(/.*)?$",
      "dest": "/tallyprime/support/index.html"
    },
    {
      "src": "^/tallyprime/customization(/.*)?$",
      "dest": "/tallyprime/customization/index.html"
    },
    {
      "src": "^/tallyprime/data-migration(/.*)?$",
      "dest": "/tallyprime/data-migration/index.html"
    },
    {
      "src": "^/tallyprime(/.*)?$",
      "dest": "/tallyprime/index.html"
    },
    {
      "src": "^/industries/manufacturing(/.*)?$",
      "dest": "/industries/manufacturing/index.html"
    },
    {
      "src": "^/industries/distribution(/.*)?$",
      "dest": "/industries/distribution/index.html"
    },
    {
      "src": "^/industries/retail(/.*)?$",
      "dest": "/industries/retail/index.html"
    },
    {
      "src": "^/industries/construction(/.*)?$",
      "dest": "/industries/construction/index.html"
    },
    {
      "src": "^/industries/hardware(/.*)?$",
      "dest": "/industries/hardware/index.html"
    },
    {
      "src": "^/industries/ngos(/.*)?$",
      "dest": "/industries/ngos/index.html"
    },
    {
      "src": "^/industries/schools(/.*)?$",
      "dest": "/industries/schools/index.html"
    },
    {
      "src": "^/industries/saccos(/.*)?$",
      "dest": "/industries/saccos/index.html"
    },
    {
      "src": "^/industries(/.*)?$",
      "dest": "/industries/index.html"
    },
    {
      "src": "^/about(/.*)?$",
      "dest": "/about/index.html"
    },
    {
      "src": "^/blog(/.*)?$",
      "dest": "/blog/index.html"
    },
    {
      "src": "^/contact(/.*)?$",
      "dest": "/contact/index.html"
    },
    {
      "src": "^/faq(/.*)?$",
      "dest": "/faq/index.html"
    },
    {
      "src": "^/pricing(/.*)?$",
      "dest": "/pricing/index.html"
    },
    {
      "src": "^/knowledge-hub(/.*)?$",
      "dest": "/knowledge-hub/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ],
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "true"
    }
  }
}
