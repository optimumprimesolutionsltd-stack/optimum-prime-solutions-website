{
  "version": 2,
  "builds": [
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(.*\\..+)$",
      "dest": "/dist/$1"
    },
    {
      "src": "^/$",
      "dest": "/dist/index.html"
    },
    {
      "src": "^/tallyprime/implementation(/.*)?$",
      "dest": "/dist/tallyprime/implementation/index.html"
    },
    {
      "src": "^/tallyprime/licensing(/.*)?$",
      "dest": "/dist/tallyprime/licensing/index.html"
    },
    {
      "src": "^/tallyprime/cloud-hosting(/.*)?$",
      "dest": "/dist/tallyprime/cloud-hosting/index.html"
    },
    {
      "src": "^/tallyprime/training(/.*)?$",
      "dest": "/dist/tallyprime/training/index.html"
    },
    {
