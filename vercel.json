    },
    {
      "src": "^/industries/distribution(/.*)?$",
      "dest": "/dist/industries/distribution/index.html"
    },
    {
      "src": "^/industries/retail(/.*)?$",
      "dest": "/dist/industries/retail/index.html"
    },
    {
      "src": "^/industries/construction(/.*)?$",
      "dest": "/dist/industries/construction/index.html"
    },
    {
      "src": "^/industries/hardware(/.*)?$",
      "dest": "/dist/industries/hardware/index.html"
    },
    {
      "src": "^/industries/ngos(/.*)?$",
      "dest": "/dist/industries/ngos/index.html"
    },
    {
      "src": "^/industries/ngo(/.*)?$",
      "dest": "/dist/industries/ngo/index.html"
    },
    {
      "src": "^/industries/schools(/.*)?$",
      "dest": "/dist/industries/schools/index.html"
    },
    {
      "src": "^/industries/saccos(/.*)?$",
      "dest": "/dist/industries/saccos/index.html"
    },
    {
      "src": "^/industries/sacco(/.*)?$",
      "dest": "/dist/industries/sacco/index.html"
    },
    {
      "src": "^/industries(/.*)?$",
      "dest": "/dist/industries/index.html"
    },
    {
      "src": "^/manufacturing/?$",
      "status": 301,
      "headers": { "Location": "/industries/manufacturing/" }
