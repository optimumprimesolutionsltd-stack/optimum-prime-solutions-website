{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "vite build && node prerender.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    {
      "src": "^/(.*\\..+)$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/$1/index.html"
    }
  ]
}
