    },
    {
      "src": "^/tallyprime/data-migration(/.*)?$",
      "dest": "/dist/tallyprime/data-migration/index.html"
    },
    {
      "src": "^/tallyprime/consulting(/.*)?$",
      "dest": "/dist/tallyprime/consulting/index.html"
    },
    {
      "src": "^/tally-prime-kenya(/.*)?$",
      "dest": "/dist/tally-prime-kenya/index.html"
    },
    {
      "src": "^/tallyprime(/.*)?$",
      "dest": "/dist/tallyprime/index.html"
    },
    {
      "src": "^/industries/manufacturing(/.*)?$",
