# Cloud Functions environment. Copy to functions/.env (gitignored) and fill in.
# firebase deploy --only functions picks these up automatically.

# --- existing ---
RESEND_API_KEY=
TEST_EMAIL_TOKEN=

# --- SaaS subscription sync (syncSaasSubscriptions) ---
# Each product's super-admin org list + its read-only Bearer key.
MAVUNO_ORGS_URL=https://mavunohr.co.ke/api/super/orgs
MAVUNO_SYNC_KEY=

# Jamvi's equivalent — leave blank until Chege-Project exposes the endpoint.
JAMVI_ORGS_URL=
JAMVI_SYNC_KEY=

# Guards the manual "Sync now" HTTP trigger (syncSaasSubscriptionsNow).
SAAS_SYNC_TRIGGER_TOKEN=
